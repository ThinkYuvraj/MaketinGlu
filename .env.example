# ==============================================================================
# Marketing LU - Hostinger Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual production/staging values.
# Add these exact Key/Value pairs in Hostinger's Node.js App "Environment variables"
# ==============================================================================

# Application Environment (production / development)
NODE_ENV=production

# Frontend Public Domain
FRONTEND_URL=https://yourdomain.com

# Admin Authentication Credentials (Required for Admin Dashboard)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password

# Inquiries & Customer Leads Receiver Email
INQUIRY_EMAIL=inquiries@yourdomain.com

# Gmail Outbound SMTP Dispatcher Settings
# For Gmail, use an App Password generated at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password

# Server Port
PORT=3000

# Optional Google Gemini API Key
GEMINI_API_KEY=
