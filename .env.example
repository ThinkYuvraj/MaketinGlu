# ==============================================================================
# Marketing LU - Environment Variables Template (.env.example)
# Copy this file to .env and adjust the values as needed.
# ==============================================================================

# Application Environment (development | production)
NODE_ENV=development

# Server Ports
PORT=3000
VITE_PORT=5173

# Frontend Public Domain (GoDaddy Domain)
FRONTEND_URL=https://marketinglu.com

# Admin Authentication Credentials (Required for Admin Dashboard)
ADMIN_EMAIL=admin@marketinglu.com
ADMIN_PASSWORD=admin123

# Google Gemini API Key (Optional for AI-powered copywriting & marketing generation)
GEMINI_API_KEY=